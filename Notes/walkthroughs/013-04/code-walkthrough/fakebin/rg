#!/bin/sh
# Emit a valid ripgrep JSON stream with matches across multiple files,
# then exit 0. The app enters the browse state and loads files from disk.
# Files: alpha.txt (lines 1, 3), beta.txt (lines 2, 5), gamma.txt (line 4).
# This exercises cross-file navigation and same-file navigation.
echo '{"type":"begin","data":{"path":{"text":"alpha.txt"}}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"alpha.txt"},"lines":{"text":"match alpha line 1\n"},"line_number":1,"submatches":[{"match":{"text":"match"},"start":0,"end":5}]}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"alpha.txt"},"lines":{"text":"match alpha line 3\n"},"line_number":3,"submatches":[{"match":{"text":"match"},"start":0,"end":5}]}}'
echo '{"type":"end","data":{"path":{"text":"alpha.txt"},"binary_offset":null}}'
echo '{"type":"begin","data":{"path":{"text":"beta.txt"}}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"beta.txt"},"lines":{"text":"match beta line 2\n"},"line_number":2,"submatches":[{"match":{"text":"match"},"start":0,"end":5}]}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"beta.txt"},"lines":{"text":"match beta line 5\n"},"line_number":5,"submatches":[{"match":{"text":"match"},"start":0,"end":5}]}}'
echo '{"type":"end","data":{"path":{"text":"beta.txt"},"binary_offset":null}}'
echo '{"type":"begin","data":{"path":{"text":"gamma.txt"}}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"gamma.txt"},"lines":{"text":"match gamma line 4\n"},"line_number":4,"submatches":[{"match":{"text":"match"},"start":0,"end":5}]}}'
echo '{"type":"end","data":{"path":{"text":"gamma.txt"},"binary_offset":null}}'
echo '{"type":"summary","data":{}}'
exit 0
