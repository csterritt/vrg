#!/bin/bash
# Fake rg that emits a valid begin/match/end stream for test.txt, then
# a valid summary, then a context record, then exits 0. Per the
# summary-is-final contract (Issue #36 parser change, Issue #44
# dedicated coverage) the post-summary context record is a
# stream-integrity failure: vrg shows an error overlay naming
# "record after summary" — never silently accepting it. With retained
# results the overlay is non-fatal: q dismisses to browse, q again
# exits 2. The same diagnostic is replayed to stderr after terminal
# restoration.
echo '{"type":"begin","data":{"path":{"text":"demo/test.txt"}}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"demo/test.txt"},"lines":{"text":"hello world\n"},"line_number":1,"submatches":[{"match":{"text":"hello"},"start":0,"end":5}]}}'
echo '{"type":"end","data":{"path":{"text":"demo/test.txt"},"binary_offset":null}}'
echo '{"type":"summary","data":{}}'
printf '%s\n' '{"type":"context","data":{"path":{"text":"demo/test.txt"},"lines":{"text":"hello world\n"},"line_number":1}}'
exit 0
