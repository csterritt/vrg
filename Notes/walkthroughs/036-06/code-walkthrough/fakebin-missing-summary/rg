#!/bin/bash
# Fake rg that emits a valid begin/match/end stream for test.txt but
# terminates WITHOUT a summary record, then exits 0. vrg should show a
# fatal error overlay naming "missing summary record" rather than
# "ripgrep exited with code 0". q dismisses the overlay to browse; q
# again exits 2. The same diagnostic is replayed to stderr after
# terminal restoration.
echo '{"type":"begin","data":{"path":{"text":"demo/test.txt"}}}'
printf '%s\n' '{"type":"match","data":{"path":{"text":"demo/test.txt"},"lines":{"text":"hello world\n"},"line_number":1,"submatches":[{"match":{"text":"hello"},"start":0,"end":5}]}}'
echo '{"type":"end","data":{"path":{"text":"demo/test.txt"},"binary_offset":null}}'
exit 0
